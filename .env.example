# Multi-AI Relay Hub — Environment Variables
# Copy this file to `.env` and uncomment the lines you want to change.

# Timeout (seconds) for each AI subprocess (default: 600)
# RELAY_TIMEOUT_SEC=600

# Maximum context characters sent to each AI (default: 32000)
# MAX_CONTEXT_CHARS=32000

# Relay mode: "readonly" (default) or "full"
#   readonly = all three CLIs receive explicit read-only settings
#   full     = only RELAY_EXECUTOR receives write permission
# RELAY_MODE=readonly

# The only agent allowed to write in full mode: claude, codex, or gemini
# RELAY_EXECUTOR=codex

# Optional native executable or JavaScript entry-point overrides
# CLAUDE_CLI_PATH=
# CODEX_CLI_PATH=
# GEMINI_CLI_PATH=
